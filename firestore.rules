rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admins: a document with the admin's UID as its ID. Create these by hand in the Firebase console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /reports/{id} {
      allow read: if true;
      // Citizens can only create new, unprocessed reports
      allow create: if request.resource.data.status == 'new'
                    && !('proof' in request.resource.data)
                    && !('dept' in request.resource.data);
      // Only admins can dispatch, add proof or delete
      allow update, delete: if isAdmin();
    }
  }
}
